# El banco de pruebas: se genera con tools/bench/make-bench.sh en un minuto,
# y lleva dentro una copia de 'orbit' que no es nuestra y que caducaría.
/.bench/

# Rust
/target/
**/*.rs.bk

# Node
node_modules/
dist/
.vite/

# Tauri
src-tauri/target/
src-tauri/gen/

# Python de las pruebas de escapado
__pycache__/
*.pyc

# Sistema
.DS_Store
*.log
*.tmp
*.swp
*.local

# El impresor de argv de la prueba de propiedad, si queda suelto en /tmp
orbit-desktop-impresor.sh

# Lo que genera tauri-build en cada compilación.
crates/orbit-app/gen/
